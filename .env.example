# Copiar este archivo como .env y reemplazar cada valor CAMBIAR_* con valores de desarrollo.
# Compose lee .env para interpolar variables; no subir el archivo .env real al repositorio.

# Backend
NODE_ENV=dev
BACKEND_HOST_PORT=3000

# URL publica del frontend: se usa para redirecciones despues de verificar el correo.
# En el servidor, usar el origen HTTPS publico del frontend.
FRONTEND_URL=http://localhost:11001
# URL accesible por el usuario para abrir el enlace de verificacion; /api se proxifica por Nginx.
BASE_URL=http://localhost:11001
# Sustituir por un secreto largo, aleatorio y exclusivo de cada entorno.
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO

# SMTP de pruebas; usar credenciales ficticias en este archivo y definir las reales solo en .env.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=CAMBIAR_USUARIO_SMTP
MAIL_PASS=CAMBIAR_PASSWORD_SMTP
MAIL_FROM=no-reply@example.test

# MongoDB: la URI debe usar el nombre de servicio mongo-practi dentro de Docker.
# Si la password tiene caracteres reservados, codificarlos para URI (percent-encoding).
# La password de MONGO_URI debe coincidir con MONGO_INITDB_ROOT_PASSWORD.
# Las variables MONGO_INITDB_* solo inicializan un volumen vacio; no cambian usuarios de mongodb_data existente.
MONGO_INITDB_ROOT_USERNAME=tass
MONGO_INITDB_ROOT_PASSWORD=CAMBIAR_PASSWORD_MONGO
MONGO_URI=mongodb://tass:CAMBIAR_PASSWORD_MONGO@mongo-practi:27017/trabajotass?authSource=admin
# MongoDB solo se publica en la interfaz elegida; 127.0.0.1 evita exponerlo a otras interfaces.
MONGO_BIND_ADDRESS=127.0.0.1
MONGO_HOST_PORT=27018

# Puerto publicado del frontend y configuracion Angular compilada dentro de la imagen.
# Para Docker usar production o preprod: ambos usan rutas API relativas y el proxy Nginx.
FRONTEND_HOST_PORT=11001
FRONTEND_ENV=production

# RabbitMQ es persistente y solo accesible desde la red Compose; el backend aun no lo consume.
RABBITMQ_ADMIN_PASSWORD=CAMBIAR_PASSWORD_RABBITMQ_ADMIN
RABBITMQ_BACKEND_PASSWORD=CAMBIAR_PASSWORD_RABBITMQ_BACKEND
# Redis tambien es interno y aun no esta integrado al codigo del backend.
REDIS_MAXMEMORY=128mb
REDIS_MAXMEMORY_POLICY=allkeys-lru